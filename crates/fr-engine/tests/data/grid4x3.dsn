(pcb grid.dsn
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  28000 0  28000 -22000  0 -22000  0 0))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 200))
  )
  (placement
    (component "R_0603"
      (place R1 3000 -3000 front 90)
      (place R2 9000 -3000 front 0)
      (place R3 15000 -3000 front 0)
      (place R4 21000 -3000 front 90)
      (place R5 3000 -9000 front 0)
      (place R6 9000 -9000 front 0)
      (place R7 15000 -9000 front 90)
      (place R8 21000 -9000 front 0)
      (place R9 3000 -15000 front 0)
      (place R10 9000 -15000 front 90)
      (place R11 15000 -15000 front 0)
      (place R12 21000 -15000 front 0)
    )
  )
  (library
    (image "R_0603"
      (pin Pad 1 -825 0)
      (pin Pad 2 825 0)
    )
    (padstack Pad (shape (polygon F.Cu 0  -400 475  400 475  400 -475  -400 -475)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off))
  )
  (network
    (net N1 (pins R2-2 R6-1))
    (net N2 (pins R3-2 R11-1))
    (net N4 (pins R5-2 R9-1))
    (net N5 (pins R6-2 R2-1))
    (net N7 (pins R8-2 R12-1))
    (net N8 (pins R9-2 R5-1))
    (net N10 (pins R11-2 R3-1))
    (net N11 (pins R12-2 R8-1))
    (class kicad_default N1 N2 N4 N5 N7 N8 N10 N11 (circuit (use_via "Via[0-1]_600:300_um")) (rule (width 200) (clearance 200)))
  )
  (wiring
  )
)
