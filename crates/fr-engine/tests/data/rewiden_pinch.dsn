(pcb rewiden_pinch.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.5")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  0 0  20000 0  20000 12000  0 12000  0 0)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 150)
      (clearance 150)
    )
  )
  (placement
    (component "TP"
      (place WA 2000 5000 front 0)
      (place WB 18000 5000 front 0)
      (place SA 5000 9000 front 0)
      (place SB 15000 9000 front 0)
    )
  )
  (library
    (image "TP"
      (pin Pad300 1 0 0)
    )
    (padstack Pad300
      (shape (polygon F.Cu 0  -150 150  150 150  150 -150  -150 -150))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net W
      (pins WA-1 WB-1)
    )
    (net S
      (pins SA-1 SB-1)
    )
    (class kicad_default S
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 150)
        (clearance 150)
      )
    )
    (class power W
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 600)
        (clearance 150)
      )
    )
  )
  (wiring
    (wire (path F.Cu 200  2000 5000  18000 5000)(net W))
    (wire (path F.Cu 150  5000 9000  5000 5325  15000 5325  15000 9000)(net S) (type fix))
  )
)
