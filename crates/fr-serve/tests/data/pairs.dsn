(pcb pairs.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.5")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  40000 -30000  10000 -30000  10000 -5000  40000 -5000
            40000 -30000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 152.4)
      (clearance 152.4)
      (clearance 38.1 (type smd_smd))
    )
  )
  (placement
    (component "R_0603"
      (place R1 14000 -10000 front 0 (PN 1k))
      (place R2 34000 -10000 front 0 (PN 1k))
      (place R3 14000 -11200 front 0 (PN 1k))
      (place R4 33000 -11200 front 0 (PN 1k))
      (place R5 14000 -20000 front 0 (PN 1k))
      (place R6 20000 -20000 front 0 (PN 1k))
      (place R7 14000 -25000 front 0 (PN 1k))
      (place R8 34000 -25000 front 0 (PN 1k))
    )
  )
  (library
    (image "R_0603"
      (outline (polygon signal 0  1475 -725  -1475 -725  -1475 725  1475 725))
      (pin RoundRect[T]Pad_800.000000x950.000000_200.761000_um_0.000000_0 1 -825 0)
      (pin RoundRect[T]Pad_800.000000x950.000000_200.761000_um_0.000000_0 2 825 0)
    )
    (padstack RoundRect[T]Pad_800.000000x950.000000_200.761000_um_0.000000_0
      (shape (polygon F.Cu 0  -400 475  400 475  400 -475  -400 -475))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net USB_P
      (pins R1-2 R2-1)
    )
    (net USB_N
      (pins R3-2 R4-1)
    )
    (net T1
      (pins R5-2 R6-1)
    )
    (net T2
      (pins R7-2 R8-1)
    )
    (net GND
      (pins R1-1 R3-1 R5-1 R7-1)
    )
    (net GND2
      (pins R2-2 R4-2 R6-2 R8-2)
    )
    (class kicad_default USB_P USB_N T1 T2 GND GND2
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 152.4)
        (clearance 152.4)
      )
    )
  )
  (wiring
  )
)
